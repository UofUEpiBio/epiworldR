\examples{
# 1,000 agents in households of 4: everyone meets their housemates daily
sir <- ModelSIR(
  name              = "flu",
  n                 = 1000,
  prevalence        = .01,
  transmission_prob = .2,
  recovery_rate     = .1
)

households <- layer_mixing(
  "households",
  groups       = (0:999) \%/\% 4,
  contact_prob = 1
)
add_layer(sir, households)

